    {
      "type": "text",
      "id": "oid_evidence_text",
      "x": 475, "y": 100,
      "width": 340, "height": 140,
      "text": "X509v3 extensions:\n  Subject: CN = *.konductor.arpa\n  Issuer:  CN = Konductor CA\n  Key:     id-ecPublicKey (P-256)\n\n  Custom OID extensions:\n  1.3.6.1.4.1.57264.1.1:\n    git_commit=a1b2c3d4e5f6\n  1.3.6.1.4.1.57264.1.2:\n    nix_derivation=/nix/store/abc123",
      "originalText": "X509v3 extensions:\n  Subject: CN = *.konductor.arpa\n  Issuer:  CN = Konductor CA\n  Key:     id-ecPublicKey (P-256)\n\n  Custom OID extensions:\n  1.3.6.1.4.1.57264.1.1:\n    git_commit=a1b2c3d4e5f6\n  1.3.6.1.4.1.57264.1.2:\n    nix_derivation=/nix/store/abc123",
