    {
      "type": "text",
      "id": "env_evidence_text",
      "x": 475, "y": 360,
      "width": 330, "height": 152,
      "text": "SSL_CERT_FILE=<bundle>\nCURL_CA_BUNDLE=<bundle>\nGIT_SSL_CAINFO=<bundle>\nREQUESTS_CA_BUNDLE=<bundle>\nNODE_EXTRA_CA_CERTS=<bundle>\nNIX_SSL_CERT_FILE=<bundle>\n\n# Internal registries: no --insecure\n# Internal Gitea: no GIT_SSL_NO_VERIFY\n# The chain compounds automatically",
      "originalText": "SSL_CERT_FILE=<bundle>\nCURL_CA_BUNDLE=<bundle>\nGIT_SSL_CAINFO=<bundle>\nREQUESTS_CA_BUNDLE=<bundle>\nNODE_EXTRA_CA_CERTS=<bundle>\nNIX_SSL_CERT_FILE=<bundle>\n\n# Internal registries: no --insecure\n# Internal Gitea: no GIT_SSL_NO_VERIFY\n# The chain compounds automatically",
      "fontSize": 12,
