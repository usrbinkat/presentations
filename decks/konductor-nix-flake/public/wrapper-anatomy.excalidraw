    {
      "type": "text",
      "id": "src_evidence_text",
      "x": 45, "y": 130,
      "width": 340, "height": 200,
      "text": "src/config/linters/shellcheck/\n  default.nix       <- wrapper\n  .shellcheckrc     <- config dotfile\n\nsrc/config/formatters/prettier/\n  default.nix       <- wrapper\n  .prettierrc.yaml  <- config dotfile\n  plugin-slidev/    <- plugins sealed\n\nsrc/config/linters/nixfmt/\n  default.nix\n  ...13 linters, 5 formatters total",
      "originalText": "src/config/linters/shellcheck/\n  default.nix       <- wrapper\n  .shellcheckrc     <- config dotfile\n\nsrc/config/formatters/prettier/\n  default.nix       <- wrapper\n  .prettierrc.yaml  <- config dotfile\n  plugin-slidev/    <- plugins sealed\n\nsrc/config/linters/nixfmt/\n  default.nix\n  ...13 linters, 5 formatters total",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
