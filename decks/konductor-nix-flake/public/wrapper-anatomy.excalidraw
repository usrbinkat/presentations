    {
      "type": "text",
      "id": "bottom_note",
      "x": 30, "y": 370,
      "width": 360, "height": 80,
      "text": "Develop the config like any dotfile:\ndiff it, test it, code-review it.\nThe wrapper just seals it.\nArchitecture all the way to the minutia.",
