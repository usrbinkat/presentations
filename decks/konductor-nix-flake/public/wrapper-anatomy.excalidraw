      "id": "nix_code_text",
      "x": 475, "y": 128,
      "width": 310, "height": 82,
      "text": "pkgs.writeShellApplication {\n  name = \"shellcheck\";\n  text = ''exec\n    ${pkgs.shellcheck}/bin/shellcheck\n    --rcfile=${./.shellcheckrc} \"$@\"'';\n}",
