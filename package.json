{
  "name": "braincraft-presentations",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "slidev-workspace dev",
    "build": "slidev-workspace build",
    "lint": "eslint .",
    "format": "prettier --write '**/*.{md,vue,ts,css,json,yaml}' --plugin prettier-plugin-slidev",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "simple-git-hooks",
    "new-deck": "node scripts/new-deck.mjs",
    "new-layout": "node scripts/new-layout.mjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@iconify-json/carbon": "catalog:",
    "@iconify-json/logos": "catalog:",
    "@slidev/cli": "catalog:",
    "@slidev/client": "catalog:",
    "@slidev/types": "catalog:",
    "eslint": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-slidev": "catalog:",
    "simple-git-hooks": "catalog:",
    "slidev-workspace": "^0.9.3",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{vue,ts,js}": "eslint --fix",
    "*.{md,css,json,yaml,yml}": "prettier --write"
  },
  "dependencies": {
    "slidev-addon-excalidraw": "^1.0.4"
  }
}
