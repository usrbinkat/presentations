{
  "name": "braincraft-presentations",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "slidev-workspace dev",
    "build": "slidev-workspace build",
    "lint": "eslint .",
    "format": "eslint --fix .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run && vitest run --config packages/slidev-theme-braincraft/__tests__/vitest.config.base.ts --root .",
    "test:watch": "vitest",
    "prepare": "simple-git-hooks",
    "new-deck": "node scripts/new-deck.mjs",
    "new-layout": "node scripts/new-layout.mjs"
  },
  "dependencies": {
    "slidev-addon-excalidraw": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@iconify-json/carbon": "catalog:",
    "@iconify-json/logos": "catalog:",
    "@slidev/cli": "catalog:",
    "@slidev/client": "catalog:",
    "@slidev/types": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "lint-staged": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-slidev": "catalog:",
    "simple-git-hooks": "catalog:",
    "sirv": "catalog:",
    "slidev-workspace": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
