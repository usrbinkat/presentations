---
interface Props {
  title: string;
  description: string;
  slug: string;
  slideCount?: number;
  duration?: string;
  audiences?: string[];
  tone?: 'cool' | 'mint' | 'warm';
  featured?: boolean;
}

const {
  title,
  description,
  slug,
  slideCount,
  duration,
  audiences = [],
  tone = 'cool',
  featured = false,
} = Astro.props;

import { href } from '../utils/paths';

const toneClass = `tone-${tone}`;
const deckUrl = href(`/${slug}`);
const presentUrl = href(`/${slug}/slides/`);
---

<div class:list={[
  'deck-card group relative flex flex-col p-6 bg-surface-paper border border-border-subtle rounded-2xl transition-all duration-300 overflow-hidden',
  'hover:shadow-xl hover:border-brand-primary/30 hover:-translate-y-1',
  featured && 'md:col-span-2',
  toneClass,
]}>
  <div class="absolute inset-0 bg-gradient-to-br from-brand-primary/3 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" style={`--tw-gradient-from: var(--section-accent);`}></div>

  <div class="relative z-10 flex flex-col flex-1 gap-4">
    <div class="flex items-start justify-between gap-3">
      <h3 class="text-xl font-bold text-text-primary group-hover:text-brand-primary transition-colors leading-tight">
        {title}
      </h3>
      {duration && (
        <span class="flex-shrink-0 text-xs font-mono text-text-tertiary bg-surface-subtle px-2 py-1 rounded-md">
          {duration}
        </span>
      )}
    </div>

    <p class="text-sm text-text-secondary leading-relaxed flex-1">
      {description}
    </p>

    {audiences.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {audiences.map(audience => (
          <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-surface-subtle text-text-tertiary">
            {audience}
          </span>
        ))}
      </div>
    )}

    <div class="flex items-center justify-between pt-2 border-t border-border-subtle">
      <div class="flex items-center gap-3">
        {slideCount && (
          <span class="text-xs font-mono text-text-tertiary">
            {slideCount} slides
          </span>
        )}
      </div>
      <div class="flex items-center gap-2">
        <a
          href={presentUrl}
          class="text-xs font-medium text-text-tertiary hover:text-text-primary transition-colors px-2 py-1 rounded-md hover:bg-surface-subtle"
          title="Open presentation directly"
        >
          Present
        </a>
        <a
          href={deckUrl}
          class="btn btn-primary text-sm py-1.5 px-3"
          data-astro-prefetch
        >
          Details
          <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>
